{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "oie-site",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    {
      "pattern": "oie.araihu.com",
      "custom_domain": true
    }
  ]
}
